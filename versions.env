# Pinned inputs for the FFmpeg Android build. Plain KEY=VALUE lines only:
# this file is sourced by bash and appended to $GITHUB_ENV (comments are filtered out).

# FFmpeg 8.1.3, verified against the FFmpeg release signing key
# (FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8).
FFMPEG_VERSION=8.1.3
FFMPEG_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3

# Android NDK r28c. Must match the NDK used by the app's own JNI code.
NDK_VERSION=28.2.13676358

# minSdk of the Mediany app.
ANDROID_API=26
