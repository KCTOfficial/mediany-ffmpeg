# Pinned inputs for the FFmpeg Android build. Plain KEY=VALUE lines only:
# this file is sourced by bash and appended to $GITHUB_ENV (comments are filtered out).

# FFmpeg 8.1.3, verified against the FFmpeg release signing key
# (FCF9 86EA 15E6 E293 A564 4F10 B432 2F04 D676 58D8).
FFMPEG_VERSION=8.1.3
FFMPEG_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3

# Android NDK r28c. Must match the NDK used by the app's own JNI code.
NDK_VERSION=28.2.13676358

# minSdk of the Mediany app.
ANDROID_API=26

# External codec libraries, linked statically into the FFmpeg shared libraries.
# All are LGPL or BSD-style; none is GPL. Checksums pin the exact release tarballs
# (dav1d's matches its upstream .sha256 file; the others were taken over HTTPS from
# the official hosts). libvpx has no release tarball and is pinned to its tag commit.
LAME_VERSION=3.101
LAME_SHA256=7578af6eebd578b2bd64e468fac4ae1f03670a7e028166e67f855674b9b6aeac
OGG_VERSION=1.3.6
OGG_SHA256=5c8253428e181840cd20d41f3ca16557a9cc04bad4a3d04cce84808677fa1061
VORBIS_VERSION=1.3.7
VORBIS_SHA256=b33cc4934322bcbf6efcbacf49e3ca01aadbea4114ec9589d1b1e9d20f72954b
OPUS_VERSION=1.6.1
OPUS_SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1
VPX_VERSION=1.17.0
VPX_COMMIT=6df3ec34557879fff673706f4a1d9fbd0f3a6f0e
DAV1D_VERSION=1.5.4
DAV1D_SHA256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5
AOM_VERSION=3.15.3
AOM_SHA256=12c01dc731ed7b5a999e28120b45bf58a002ba3435a4ba2cfbc1e084a27c9c04
WEBP_VERSION=1.6.0
WEBP_SHA256=e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564
SOXR_VERSION=0.1.3
